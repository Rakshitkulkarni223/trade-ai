# --- Storage. SQLite by default; set a Postgres URL to switch. Redis is optional.
DATABASE_URL=sqlite:///./tradeai.db
REDIS_URL=

# --- Market data needs no key: Binance (crypto) and Yahoo Finance (stocks, indices, metals).

# --- AI providers. Leave all blank to use the deterministic offline explainer.
AI_PROVIDER=auto            # auto | anthropic | openai | gemini | offline
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite   # cheapest tier that works here; gemini-3.8-flash is the stronger option
ANTHROPIC_API_KEY=

# --- App
FRONTEND_URL=http://localhost:5173

# --- Deployment (leave blank for local development)
# STATIC_DIR makes the API serve the built frontend (the Dockerfile sets it). On a public deployment ALWAYS set
# APP_PASSWORD: the AI endpoints use your model key, and without it anyone with the URL can spend it.
STATIC_DIR=
APP_PASSWORD=
# On Railway use the Postgres plugin:  DATABASE_URL=${{Postgres.DATABASE_URL}}   (postgres:// URLs are handled)
